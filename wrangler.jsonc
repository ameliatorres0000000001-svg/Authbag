{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "authbag",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // These IDs are NOT secrets. They were created through the Cloudflare connector.
  "d1_databases": [
    { "binding": "DB", "database_name": "hengz-authentic", "database_id": "43949a74-3876-4fe9-9818-d662d2d1467c", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "VAULT", "bucket_name": "hengz-vault-private" }
  ],
  // Workers AI: background removal for the trending-model photos (bria/remove-background)
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  // background jobs: translate teaching points still missing Khmer + English
  "triggers": { "crons": ["*/10 * * * *"] },
  // ANTHROPIC_BASE_URL: the Claude gateway the shop's key was bought from (not a secret). Set it to "" to use a
  // key from platform.claude.com directly.
  "vars": { "AI_MODEL": "", "AZURE_SPEECH_REGION": "southeastasia", "ANTHROPIC_BASE_URL": "https://api.laalaa.me" }
  // Optional secrets (set with `wrangler secret put NAME`, never committed):
  //   AZURE_SPEECH_KEY  – Azure AI Speech key for Khmer voice (text-to-speech); region is the var above
  //   ENTRUPY_API_KEY   – only after Entrupy approves your business account
  //   Claude through Amazon Bedrock (no web search there): BEDROCK_API_KEY (a Bedrock API key), or AWS_ACCESS_KEY_ID +
  //   AWS_SECRET_ACCESS_KEY (+ AWS_SESSION_TOKEN) with IAM bedrock-mantle:CreateInference; region: AWS_REGION (default us-east-1);
  //   models are anthropic.claude-sonnet-5-5 / anthropic.claude-opus-5-5. AI_PROVIDER (anthropic | bedrock | openai | gemini) forces the main one.
  //   Any OpenAI-compatible API (OpenAI, a gateway, OpenRouter…): OPENAI_API_KEY + OPENAI_MODEL (+ OPENAI_BASE_URL, https,
  //   default https://api.openai.com/v1). Every AI that has a key backs up the main one automatically (tried in turn).
  //   ANTHROPIC_API_KEY (Claude, default model claude-sonnet-5-5) or GEMINI_API_KEY (default gemini-3.8-flash); AI_MODEL var overrides the model – enables AI observation *suggestions* (never verdicts)
}
