{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "authbag",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // These IDs are NOT secrets. They were created through the Cloudflare connector.
  "d1_databases": [
    { "binding": "DB", "database_name": "hengz-authentic", "database_id": "43949a74-3876-4fe9-9818-d662d2d1467c", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "VAULT", "bucket_name": "hengz-vault-private" }
  ],
  "observability": { "enabled": true },
  // background jobs: translate teaching points still missing Khmer + English
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": { "AI_MODEL": "" }
  // Optional secrets (set with `wrangler secret put NAME`, never committed):
  //   ANTHROPIC_BASE_URL – optional https gateway in front of Claude (empty = api.anthropic.com); its key goes in ANTHROPIC_API_KEY
  //   ENTRUPY_API_KEY   – only after Entrupy approves your business account
  //   ANTHROPIC_API_KEY (Claude, default model claude-sonnet-5-5) or GEMINI_API_KEY (default gemini-3.8-flash); AI_MODEL var overrides the model – enables AI observation *suggestions* (never verdicts)
}
